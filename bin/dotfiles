#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  bin/dotfiles install
  bin/dotfiles import [target]

Commands:
  install     Install Homebrew and development tools
  import      Import managed config files

Targets:
  all         Import all managed config files
  git-config Import ~/.gitconfig
  git-ignore  Import ~/.config/git/ignore
  zsh-aliases Import zsh aliases and load them from ~/.zshrc
  zsh-peco    Import peco widgets and load them from ~/.zshrc
  zsh-tools   Configure Homebrew, mise, and Starship for zsh
USAGE
}

install_homebrew() {
  if ! command -v brew >/dev/null 2>&1; then
    printf 'Installing Homebrew...\n'
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
  else
    printf 'Homebrew installation completed, but brew was not found.\n' >&2
    exit 1
  fi
}

install_tools() {
  install_homebrew
  brew bundle --file="$ROOT_DIR/Brewfile"
}

import_file() {
  local source_path="$1"
  local destination_path="$2"

  mkdir -p "$(dirname "$destination_path")"
  cp "$source_path" "$destination_path"
  printf 'Imported %s\n' "$destination_path"
}

import_git_ignore() {
  import_file "$ROOT_DIR/config/git/ignore" "$HOME/.config/git/ignore"
}

import_git_config() {
  import_file "$ROOT_DIR/config/git/config" "$HOME/.gitconfig"
}

import_zsh_aliases() {
  local source_line='source "$HOME/.config/zsh/aliases.zsh"'

  import_file "$ROOT_DIR/config/zsh/aliases.zsh" "$HOME/.config/zsh/aliases.zsh"
  add_source_line "$HOME/.zshrc" "$source_line"
}

import_zsh_peco() {
  local source_line='source "$HOME/.config/zsh/peco.zsh"'

  import_file "$ROOT_DIR/config/zsh/peco.zsh" "$HOME/.config/zsh/peco.zsh"
  add_source_line "$HOME/.zshrc" "$source_line"
}

add_source_line() {
  local startup_file="$1"
  local source_line="$2"

  touch "$startup_file"
  if ! grep -Fqx "$source_line" "$startup_file"; then
    printf '\n%s\n' "$source_line" >> "$startup_file"
    printf 'Updated %s\n' "$startup_file"
  fi
}

import_zsh_tools() {
  import_file "$ROOT_DIR/config/zsh/homebrew.zsh" "$HOME/.config/zsh/homebrew.zsh"
  import_file "$ROOT_DIR/config/zsh/tools.zsh" "$HOME/.config/zsh/tools.zsh"

  add_source_line "$HOME/.zprofile" 'source "$HOME/.config/zsh/homebrew.zsh"'
  add_source_line "$HOME/.zshrc" 'source "$HOME/.config/zsh/tools.zsh"'
}

import_all() {
  import_git_config
  import_git_ignore
  import_zsh_aliases
  import_zsh_peco
  import_zsh_tools
}

command="${1:-}"
target="${2:-all}"

case "$command" in
  install)
    install_tools
    ;;
  import)
    case "$target" in
      all)
        import_all
        ;;
      git-ignore)
        import_git_ignore
        ;;
      git-config)
        import_git_config
        ;;
      zsh-aliases)
        import_zsh_aliases
        ;;
      zsh-peco)
        import_zsh_peco
        ;;
      zsh-tools)
        import_zsh_tools
        ;;
      *)
        printf 'Unknown import target: %s\n\n' "$target" >&2
        usage >&2
        exit 1
        ;;
    esac
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command" >&2
    usage >&2
    exit 1
    ;;
esac
